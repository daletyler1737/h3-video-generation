ame for S&R":"CLIPTextEncode","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["金黄色的夕阳下，一条繁华的古代中国仙城街道。道路两旁是装饰华丽的木制建筑，屋檐弯曲，红色的灯笼在头顶摇曳。路边摊贩正在蒸制新鲜的包子，浓浓的白雾在温暖的空气中翻腾。穿着飘逸长袍的修士和镇民川流不息地走过。镜头缓缓推近竹蒸笼，定格在热气腾腾的包子特写上。一只手从画面的右侧伸进来，轻轻拿起一个柔软蓬松的白馒头，一缕细腻的蒸汽袅袅升起。镜头流畅地跟随这只手向上移动，向上倾斜，展现出一个穿着优雅层叠白色仙袍的年轻男性修士，他乌黑的长发一直垂到腰际。他面对镜头，将馒头举到嘴边咬了一口，脸上泛起温暖而温柔的微笑。他直视镜头，用清晰自然的声音说道：“今天我们学LTX2.3文生视频。”温暖的金色阳光透过飘渺的市场蒸汽，柔和而朦胧。浅景深，逼真，4K画质。音频：繁华的古代市场声音、马蹄声在鹅卵石上敲击、远处小贩的叫卖声、镜头移动时轻微的嗖嗖声、他清晰的声音，以及微妙空灵的背景音乐。"]},{"id":44,"type":"SaveVideo","pos":[-5762.439072881674,3099.977829363965],"size":[566.4445190429688,475.9166259765625],"flags":{},"order":27,"mode":0,"inputs":[{"label":"视频","localized_name":"视频","name":"video","type":"VIDEO","link":56},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"格式","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"编解码器","name":"codec","type":"COMBO","widget":{"name":"codec"},"link":null}],"outputs":[],"properties":{"cnr_id":"comfy-core","ver":"0.21.1","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"Node name for S&R":"SaveVideo"},"widgets_values":["video/ComfyUI","mp4","h264"]},{"id":13,"type":"CLIPTextEncode","pos":[-8950.532511347674,3412.3282994032493],"size":[400,200],"flags":{"collapsed":false},"order":10,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":6},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"label":"条件","localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","links":[9]}],"properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"CLIPTextEncode","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["subtitles, text, watermark, overlaid text, lower third screen, blur, oversaturation