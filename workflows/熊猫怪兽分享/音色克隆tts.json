ype":"FLOAT","widget":{"name":"length_penalty"},"link":null},{"localized_name":"最大音频令牌","name":"max_mel_tokens","type":"INT","widget":{"name":"max_mel_tokens"},"link":null},{"localized_name":"每句最大令牌","name":"max_tokens_per_sentence","type":"INT","widget":{"name":"max_tokens_per_sentence"},"link":null},{"localized_name":"语速","name":"speech_speed","type":"FLOAT","widget":{"name":"speech_speed"},"link":null},{"localized_name":"随机种子","name":"seed","type":"INT","widget":{"name":"seed"},"link":null}],"outputs":[{"localized_name":"音频","name":"audio","type":"AUDIO","links":[19]},{"localized_name":"随机种子","name":"seed","type":"INT","links":null},{"localized_name":"字幕","name":"subtitle","type":"STRING","links":null},{"localized_name":"字幕文本","name":"subtitle_text","type":"STRING","links":null}],"properties":{"cnr_id":"comfyui-easy-indextts2","ver":"e82998572e0604be9c64f9b91f38dd611f79e4b5","Node name for S&R":"easy indexTTSGenerate"},"widgets_values":["[郭老板]咱们今儿说这么一段小故事。\n-0.15s-\n[于老师]您讲讲。\n-0.1s-\n[郭老板]有这么一户小院，院墙边上站着个姑娘，一双杏眼，怯怯生生的。\n-0.2s-\n[于老师]文静姑娘。\n-0.1s-\n[郭老板]正待着呢，院门外边有人搭话了。\n-0.15s-\n[于老师]谁啊这是？\n-0.1s-\n[郭老板]就听外边喊了一嗓子：你这婢女卖不卖？\n-0.2s-\n[于老师]嚯，上来就买卖人口啊？\n-0.1s-\n[郭老板]院里有个叫宋集薪的小伙子，当时就愣了。\n-0.15s-\n[于老师]换谁都懵。\n-0.1s-\n[郭老板]循着声音一回头，院外站着个锦衣少年，眉眼带笑，压根不认识。\n-0.2s-\n[于老师]生脸儿。\n-0.1s-\n[郭老板]少年身边还站着个高个子老者，面白和善，眯着眼往院里打量。\n-0.2s-\n[于老师]这是带管家了。\n-0.1s-\n[郭老板]老者眼神扫过旁边另一个小伙子，没停留。\n-0.15s-\n[于老师]没看上。\n-0.1s-\n[郭老板]唯独盯着宋集薪和那姑娘，看了又看，笑意越来越浓。\n-0.2s-\n[于老师]这是相中这俩了？\n-0.1s-\n[郭老板]宋集薪当时就不乐意了，斜着眼就问。\n-0.15s-\n[于老师]问什么啊？\n-0.1s-\n[郭老板]卖！怎么不卖！\n-0.2s-\n[于老师]哎？这就答应了？\n-0.1s-\n[郭老板]那少年一听乐了：行啊，你说个价。\n-0.2s-\n[于老师]还真讲价啊？\n-0.1s-\n[郭老板]旁边那姑娘眼睛都瞪圆了，满脸不敢信，跟受了惊的小鹿似的。\n-0.2s-\n[于老师]那可不，平白无故要被卖了。\n-0.1s-\n[郭老板]宋集薪翻了个白眼，伸出一根手指头，晃了晃。\n-0.15s-\n[于老师]这是开价多少啊？\n-0.1s-\n[郭老板]白银一万两！\n-0.25s-\n[于老师]好家伙，狮子大开口啊。\n-0.1s-\n[郭老板]再看那锦衣少年，脸不变色心不跳，点点头就俩字：好。\n-0.25s-\n[于老师]啊？这就应了？\n-0.1s-\n[郭老板]宋集薪一看对方不像开玩笑，赶紧改口。\n-0.15s-\n[于老师]改多少？\n-0.1s-\n[郭老板]别介，是黄金万两！\n-0.2s-\n[于老师]嘿，坐地起价啊这是。\n-0.1s-\n[郭老板]那少年嘴角一挑，乐了。\n-0.15s-\n[于老