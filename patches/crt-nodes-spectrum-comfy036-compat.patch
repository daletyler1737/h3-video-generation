+def _final_layer_takes_pdd(layer) -> bool:
+    """ComfyUI 0.36.0's FinalLayer.forward also wants (sigma, sample_sigmas, shifts)
+    so the PDD head bank can be weighted by the sampler's sigma schedule.
+    Older cores only take (x, t_emb, video_seg, audio_seg)."""
+    try:
+        params = inspect.signature(layer.forward).parameters
+    except (TypeError, ValueError):
+        return False
+    return all(name in params for name in ("sigma", "sample_sigmas", "shifts"))
